rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin(companyId) {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "superadmin"] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == companyId;
    }

    function isSuperAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == "superadmin";
    }

    // 승객 «본인» 여부 — passengerLogin(CF)이 발급한 커스텀 토큰 클레임으로만 판정한다.
    // 🔴 `users/{uid}` 를 읽지 않는다 — 승객에게는 그 문서가 아예 없어서 isAdmin 계열은
    //    언제나 거짓이고(그게 2026-05-26 부터의 «복원 실패» 정체다), 문서 읽기 비용도 0이다.
    // 🔴 세 값이 **모두** 일치해야 한다(role·회사·사번) — empNo 비교를 빼는 순간
    //    로그인한 승객 아무나 남의 문서를 읽는다.
    // ⚠ 여기 쓰는 클레임은 **식별자**(누구인가)지 권한 등급이 아니다. 등급을 커스텀 토큰에
    //    박으면 세션에 얼어붙는다(playbook backend-auth · DI_BMBOARD 2026-08-25).
    function isSelfPassenger(companyId, empNo) {
      return isAuth()
        && request.auth.token.role == "passenger"
        && request.auth.token.companyId == companyId
        && request.auth.token.empNo == empNo;
    }

    function isDriverOf(companyId) {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == "driver" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == companyId;
    }

    // ─── users ──────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ─── companies ──────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isAuth();
      allow write: if isAdmin(companyId) || isSuperAdmin();

      match /routes/{routeId} {
        allow read: if isAuth();
        allow write: if isAdmin(companyId);
        match /stops/{stopId} {
          allow read: if isAuth();
          allow write: if isAdmin(companyId);
        }
      }

      // ─── 배차 일정 (반복 패턴 정본 — Cloud Function 이 dispatches 로 펼침) ─
      match /dispatchSchedules/{scheduleId} {
        allow read:  if isAuth();
        allow write: if isAdmin(companyId);
      }

      match /dispatches/{date}/list/{dispatchId} {
        allow read: if isAuth() && (isAdmin(companyId) || isDriverOf(companyId));
        // 관리자: 전체 write 가능(기존 동작 유지)
        allow create, delete: if isAdmin(companyId);
        // update: 관리자 전체 OR 기사 본인 dispatch 의 stopArrivals 필드 한정.
        // 기사 본인 확인: drivers/{dispatch.driverId}.uid == request.auth.uid
        // (운행 시작 시 DriverApp 이 drivers.uid 를 자기 auth uid 로 update — 기존 흐름)
        allow update: if isAdmin(companyId)
          || (isDriverOf(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(resource.data.driverId)).data.uid
                 == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stopArrivals"]));
      }

      match /drivers/{driverId} {
        allow read: if isAdmin(companyId) || isDriverOf(companyId);
        // update: 관리자 전체 OR 기사 본인(운행 상태 필드 한정). dispatches 룰과 동일 패턴.
        // ⚠ admin update 누락 시 "기사 정보 수정"/PIN 재설정이 Missing permissions 로 막히고
        //   그 throw 가 뒤의 PIN/Auth 생성 블록까지 차단 → 기사 로그인 불가(2026-06-16 수정).
        //   복원 금지: isAdmin(companyId) 경로 제거 시 동일 결함 재발.
        allow update: if isAdmin(companyId)
          || (isDriverOf(companyId)
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["status", "uid", "startedAt", "endedAt"]));
        allow create, delete: if isAdmin(companyId);
      }

      match /vehicles/{vehicleId} {
        allow read: if isAdmin(companyId) || isDriverOf(companyId);
        allow write: if isAdmin(companyId);
      }

      match /passengers/{empNo} {
        allow read: if isAuth();
        allow write: if isAuth(); // 협력사 포털 업로드 허용 — 🔴 P4 에서 닫는다(P3-c 선행)
      }

      // ─── 승객 자격증명 (2026-08-28 P3-a) ──────────────
      // `pinHash` 만 담는다. 명부(`passengers`)는 read·write 가 `isAuth()` 라
      // **익명 누구나 읽고 고칠 수 있어서**(2026-08-28 실측) 해시를 거기 두면
      // ⓐ 값이 새고 ⓑ 남이 덮어써 그 계정으로 로그인된다. 그래서 분리했다.
      // 🔴 클라 접근 전면 차단 — 읽기·쓰기 모두 Admin SDK(CF) 전용.
      //    쓰는 곳 = passengerSetPin · partnerImportPassengers · partnerReissuePins.
      match /passengerSecrets/{empNo} {
        allow read, write: if false;
      }

      // ─── 승객 세션 승계표 (2026-08-25 P1) ─────────────
      // CF passengerLogin/passengerResume 가 발급한 resumeToken 의 **해시만** 담긴다.
      // 🔴 클라 접근 전면 차단 — 이 문서 ID 를 얻는 것은 곧 남의 계정 로그인이다.
      //    읽기·쓰기 모두 Admin SDK(CF) 전용. nfcRejects 와 같은 패턴.
      match /passengerSessions/{tokenHash} {
        allow read, write: if false;
      }

      match /boardings/{date}/list/{boardingId} {
        // 협력사 포털 탑승 통계 view용으로 isAuth() 허용 (2026-05-26).
        // passengers·fcmTokens와 동일 패턴 — companyId 경로 자체가 회사 분리,
        // 인증된 사용자에 한정. update/delete는 admin만.
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAdmin(companyId);
      }

      // ─── NFC 미등록 카드 태깅 기록 (부정승차, 2026-07-22) ─
      // 기사앱 NFC 태깅에서 passengers 에 매칭되는 nfcUid 가 없을 때 CF boardNfc 가 적재.
      // boardings 와 **분리** — 탑승 통계/정류장 매핑 집계에 섞이면 안 됨(회귀 방지).
      // write 는 Admin SDK(CF) 전용: 기사(role=driver)는 companies/** write 권한이 없고,
      // 클라가 직접 쓰게 하면 위조 부정승차 기록이 가능해진다.
      match /nfcRejects/{date}/list/{rejectId} {
        allow read:  if isAdmin(companyId);
        allow write: if false; // CF(Admin SDK)만 — 룰 우회
      }

      // ─── FCM 토큰 저장 ───────────────────────────────
      // 🔴 승객은 **자기 문서만** 읽는다(2026-09-01). 예전엔 read 가 admin 전용이라
      //    앱이 '내 정류장'을 **쓰기만 하고 다시 읽지 못했다** — 그래서 앱을 새로 열 때마다
      //    지정이 풀린 것처럼 보였다. `.claude/issues.md` 에 2026-05-26 부터 «비치명적»
      //    이라고 적혀 있었지만, 그게 2026-09-01 신고("아무리 지정해도 자꾸 풀립니다")의
      //    정체였다(그날 하루에만 287명이 다시 지정했다).
      // 🔴 onCall 위임을 쓰지 않은 이유 = 이 화면은 더 이상 익명이 아니다. 2026-08-25(P1)
      //    부터 승객에게 진짜 신원(커스텀 토큰)이 있고, 여기서 여는 것은 **남의 데이터가
      //    아니라 자기 문서 한 건**이다. 위임 원칙(playbook backend-auth)은 «익명 화면이
      //    남의 데이터가 든 컬렉션을 읽으려 할 때» 의 처방이라 전제가 다르다.
      match /fcmTokens/{empNo} {
        allow read:  if isSelfPassenger(companyId, empNo) || isAdmin(companyId);
        allow write: if isAuth(); // 직원 앱에서 토큰 등록
      }

      // ─── 공지사항 ────────────────────────────────────
      match /notices/{noticeId} {
        allow read:   if isAuth(); // 직원 앱에서 읽기
        allow create: if isAdmin(companyId); // 어드민만 작성
        allow update: if isAdmin(companyId); // 숨기기 등
        allow delete: if isAdmin(companyId);
      }
    }

    // ─── GPS 실시간 위치 ─────────────────────────────────
    match /gps/{vehicleKey} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ─── GPS 이력 ────────────────────────────────────────
    match /gpsHistory/{companyId}/{vehicleId}/{date}/points/{pointId} {
      allow read:   if isAdmin(companyId);
      allow create: if isAuth();
    }

    // ─── 탑승 QR 토큰 ────────────────────────────────────
    match /boardingTokens/{tokenId} {
      allow read:   if true;
      allow create: if isAuth();
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["used", "usedAt", "usedBy"]);
      allow delete: if false;
    }

    // ─── 승객 발행 탑승 QR 토큰 (역방향, 2026-05-27) ─────
    // boardingTokens 와 분리: 직원이 본인 폰에서 발행 → 기사가 자기 폰 카메라로 스캔.
    // 2분 만료·1회 소각. 직원(익명 인증)이 create, 기사가 read 후 update(소각).
    match /passengerTokens/{tokenId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ─── 협력사 코드 ─────────────────────────────────────
    match /partnerCodes/{code} {
      allow read:   if true;
      allow create: if isAuth();
      allow update: if isAuth();
      // admin/superadmin 이 자기 회사 협력사만 삭제 가능 (UI 가드: 비활성 상태에서만 삭제 허용)
      allow delete: if isAdmin(resource.data.companyId);
    }

    // ─── ETA 자동 진단 로깅 (2026-05-29) ─────────────────
    // 운행 중 DriverApp 이 30초 + stopArrivals 변경 시 자동 누적.
    // 부모(개발자)가 Firebase Console 로 회수해 정밀 진단.
    // create=isAuth() (기사 본인 익명/실명 모두 — 운행 진행 보장),
    // read=admin/superadmin (진단 데이터 보호), update/delete=false (불변 로그).
    match /etaDiagnostics/{date}/runs/{runId}/points/{pointId} {
      allow read: if isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "superadmin"];
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ─── FCM 발송 큐 (Cloud Function 트리거용) ───────────
    match /fcmQueue/{queueId} {
      allow create: if isAuth(); // 어드민이 공지 발송 시 생성
      // admin 은 발송 결과(status/successCount/failureCount/totalTokens) 구독을 위해 read 허용.
      // 자기 회사 큐만 — companyId 매칭으로 제한.
      allow read: if isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "superadmin"] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == resource.data.companyId;
      // update 는 Cloud Function 만 (Admin SDK 는 룰 우회).
      allow update: if false;
    }

    // ─── 개선 요청 게시판 (2026-07-13) ───────────────────
    // 회사 admin = 자기 회사 요청만, superadmin = 전 회사 요청.
    // buslink rules 는 catch-all 이 없어 최상위 컬렉션마다 명시 블록 필수.
    // admin 쿼리는 where companyId==X 라 isAdmin(X) 로 쿼리 단위 통과,
    // superadmin 은 orderBy 만이라 isSuperAdmin 으로 통과.
    // (issues.md '쿼리는 doc 하나라도 read 실패 시 전체 거부' 준수)
    match /improvement_requests/{id} {
      allow read:   if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if isSuperAdmin() || isAdmin(request.resource.data.companyId);
      allow update: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    // ─── 앱 설정(개선 요청 구글챗 웹훅 URL 등) ─────────────
    // config/improvementBoard.gchatWebhookUrl 를 슈퍼관리자 콘솔에서 입력.
    // CF(Admin SDK)는 룰 우회로 읽음. 클라 write 는 superadmin 만.
    match /config/{docId} {
      allow read:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
