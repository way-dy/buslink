rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin(companyId) {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "superadmin"] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == companyId;
    }

    function isSuperAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == "superadmin";
    }

    function isDriverOf(companyId) {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == "driver" &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == companyId;
    }

    // ─── users ──────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ─── companies ──────────────────────────────────────
    match /companies/{companyId} {
      allow read: if isAuth();
      allow write: if isAdmin(companyId) || isSuperAdmin();

      match /routes/{routeId} {
        allow read: if isAuth();
        allow write: if isAdmin(companyId);
        match /stops/{stopId} {
          allow read: if isAuth();
          allow write: if isAdmin(companyId);
        }
      }

      // ─── 배차 일정 (반복 패턴 정본 — Cloud Function 이 dispatches 로 펼침) ─
      match /dispatchSchedules/{scheduleId} {
        allow read:  if isAuth();
        allow write: if isAdmin(companyId);
      }

      match /dispatches/{date}/list/{dispatchId} {
        allow read: if isAuth() && (isAdmin(companyId) || isDriverOf(companyId));
        // 관리자: 전체 write 가능(기존 동작 유지)
        allow create, delete: if isAdmin(companyId);
        // update: 관리자 전체 OR 기사 본인 dispatch 의 stopArrivals 필드 한정.
        // 기사 본인 확인: drivers/{dispatch.driverId}.uid == request.auth.uid
        // (운행 시작 시 DriverApp 이 drivers.uid 를 자기 auth uid 로 update — 기존 흐름)
        allow update: if isAdmin(companyId)
          || (isDriverOf(companyId)
              && get(/databases/$(database)/documents/companies/$(companyId)/drivers/$(resource.data.driverId)).data.uid
                 == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stopArrivals"]));
      }

      match /drivers/{driverId} {
        allow read: if isAdmin(companyId) || isDriverOf(companyId);
        allow update: if isDriverOf(companyId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "uid", "startedAt", "endedAt"]);
        allow create, delete: if isAdmin(companyId);
      }

      match /vehicles/{vehicleId} {
        allow read: if isAdmin(companyId) || isDriverOf(companyId);
        allow write: if isAdmin(companyId);
      }

      match /passengers/{empNo} {
        allow read: if isAuth();
        allow write: if isAuth(); // 협력사 포털 업로드 허용
      }

      match /boardings/{date}/list/{boardingId} {
        // 협력사 포털 탑승 통계 view용으로 isAuth() 허용 (2026-05-26).
        // passengers·fcmTokens와 동일 패턴 — companyId 경로 자체가 회사 분리,
        // 인증된 사용자에 한정. update/delete는 admin만.
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAdmin(companyId);
      }

      // ─── FCM 토큰 저장 ───────────────────────────────
      match /fcmTokens/{empNo} {
        allow read:  if isAdmin(companyId);
        allow write: if isAuth(); // 직원 앱에서 토큰 등록
      }

      // ─── 공지사항 ────────────────────────────────────
      match /notices/{noticeId} {
        allow read:   if isAuth(); // 직원 앱에서 읽기
        allow create: if isAdmin(companyId); // 어드민만 작성
        allow update: if isAdmin(companyId); // 숨기기 등
        allow delete: if isAdmin(companyId);
      }
    }

    // ─── GPS 실시간 위치 ─────────────────────────────────
    match /gps/{vehicleKey} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // ─── GPS 이력 ────────────────────────────────────────
    match /gpsHistory/{companyId}/{vehicleId}/{date}/points/{pointId} {
      allow read:   if isAdmin(companyId);
      allow create: if isAuth();
    }

    // ─── 탑승 QR 토큰 ────────────────────────────────────
    match /boardingTokens/{tokenId} {
      allow read:   if true;
      allow create: if isAuth();
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["used", "usedAt", "usedBy"]);
      allow delete: if false;
    }

    // ─── 승객 발행 탑승 QR 토큰 (역방향, 2026-05-27) ─────
    // boardingTokens 와 분리: 직원이 본인 폰에서 발행 → 기사가 자기 폰 카메라로 스캔.
    // 2분 만료·1회 소각. 직원(익명 인증)이 create, 기사가 read 후 update(소각).
    match /passengerTokens/{tokenId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // ─── 협력사 코드 ─────────────────────────────────────
    match /partnerCodes/{code} {
      allow read:   if true;
      allow create: if isAuth();
      allow update: if isAuth();
      // admin/superadmin 이 자기 회사 협력사만 삭제 가능 (UI 가드: 비활성 상태에서만 삭제 허용)
      allow delete: if isAdmin(resource.data.companyId);
    }

    // ─── FCM 발송 큐 (Cloud Function 트리거용) ───────────
    match /fcmQueue/{queueId} {
      allow create: if isAuth(); // 어드민이 공지 발송 시 생성
      // admin 은 발송 결과(status/successCount/failureCount/totalTokens) 구독을 위해 read 허용.
      // 자기 회사 큐만 — companyId 매칭으로 제한.
      allow read: if isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ["admin", "superadmin"] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          == resource.data.companyId;
      // update 는 Cloud Function 만 (Admin SDK 는 룰 우회).
      allow update: if false;
    }
  }
}
