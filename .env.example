# BusLink 환경변수 템플릿 (어느 PC에서나 이어작업용)
#
# 사용법: 이 파일을 같은 폴더에 `.env.local` 로 복사한 뒤 값을 채운다.
#   - `.env.local` 은 git 추적 안 함(시크릿). 값은 사용자 보유분 입력.
#   - CRA 빌드 필수 — 값이 비면 Firebase/지도/알림이 동작 안 함.
#   - 변경 후 반드시 `npm run build` 재빌드(런타임 주입 아님, 빌드타임 치환).
#
# ── Firebase 웹 설정 (Firebase 콘솔 → 프로젝트 설정 → 내 앱) ──
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
#
# ── 카카오맵 JavaScript 키 (public/index.html 이 빌드타임 치환) ──
# ⚠ 운영 공유키 `58bf34…` 사용. 원 buslink 전용키 `d464b4…` 박으면
#    prod 지도 전체 사망(콘솔 롤백 사례 있음). 빌드 전 필수 확인.
#    카카오 디벨로퍼 Web 플랫폼에 buslink-prod.web.app·firebaseapp.com·localhost:3000 등록돼야 동작.
REACT_APP_KAKAO_MAP_KEY=
#
# ── FCM 웹 푸시 VAPID 공개키 (Firebase 콘솔 → Cloud Messaging → 웹 푸시 인증서) ──
REACT_APP_VAPID_KEY=
